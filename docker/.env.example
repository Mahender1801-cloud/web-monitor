# ============================================================================
# cp docker/.env.example docker/.env  and fill this in. docker/.env is gitignored.
#
# Nothing in here should ever be pasted into a chat window, a commit, or an
# issue. The database password and the JWT secret are the two values that make
# every other protection meaningless if they leak.
# ============================================================================

# --- database ---------------------------------------------------------------
PGUSER=monitor
PGDATABASE=monitor
# Generate, do not invent:  openssl rand -base64 32
PGPASSWORD=

# --- API auth ---------------------------------------------------------------
# The secret that signs the anon key the browser carries.
#
# Reuse Supabase's own JWT secret (Dashboard -> Settings -> API -> JWT Secret)
# and the anon key already deployed in webvitals.js keeps working — which means
# the cutover is reversible and you are not editing the theme twice.
#
# To break from Supabase entirely, generate a new one (openssl rand -base64 48)
# and mint a matching anon token; scripts/mint_token.mjs does that.
JWT_SECRET=

# --- HTTPS ------------------------------------------------------------------
# A hostname whose DNS A record points at this host, with ports 80 and 443 open.
# Caddy proves control of it to Let's Encrypt, so it must resolve publicly —
# localhost and a LAN address cannot get a certificate.
DOMAIN=rum.example.com
ACME_EMAIL=developer@hashtageyewears.com

# The one origin allowed to write. Left open to '*' this endpoint would accept
# events from anywhere, and the numbers would stop being about your store.
ALLOW_ORIGIN=https://hashtageyewears.com

# --- one-time clone from Supabase -------------------------------------------
# Supabase Dashboard -> Settings -> Database -> Connection string -> URI.
# Only used by scripts/db_clone.mjs, only while migrating. Blank it afterwards.
SUPABASE_DB_URL=
